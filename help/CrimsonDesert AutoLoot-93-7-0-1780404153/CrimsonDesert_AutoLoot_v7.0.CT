-- ================================================================
-- Burst rate limiter variables
-- ================================================================
local mem_bc = allocateMemory(4)
local mem_bm = allocateMemory(4)
writeInteger(mem_bc, 0)    -- burst count (current)
writeInteger(mem_bm, 5)    -- burst max (events per reset interval)
registerSymbol("AT_BURST_COUNT", mem_bc, true)
registerSymbol("AT_BURST_MAX",   mem_bm, true)

-- Burst reset timer (resets counter every 200ms)
local burst_timer = createTimer(nil)
burst_timer.Interval = 200
burst_timer.OnTimer = function(t)
  local addr = getAddressSafe("AT_BURST_COUNT")
  if addr then writeInteger(addr, 0) end
end
burst_timer.Enabled = true
registerSymbol("AT_BURST_TIMER_ID", burst_timer.Handle, true)

-- ================================================================
-- Hotkey: F9 toggles AT_ENABLED
-- ================================================================
local hk = createHotkey(function()
  local addr = getAddressSafe("AT_ENABLED")
  if addr then
    local cur = readInteger(addr)
    if cur == 0 then
      writeInteger(addr, 1)
      print("[AutoLoot] ON")
    else
      writeInteger(addr, 0)
      print("[AutoLoot] OFF")
    end
  end
end, VK_F9)
registerSymbol("AT_HOTKEY_ID", hk, true)

-- ================================================================
-- Helper: resolve RIP-relative address from instruction bytes
-- ================================================================
local function resolveRIP(insn_addr, insn_len, disp_off)
  local disp = readInteger(insn_addr + disp_off)
  if disp == nil then return nil end
  if disp &gt;= 0x80000000 then disp = disp - 0x100000000 end
  return insn_addr + insn_len + disp
end

-- ================================================================
-- Runtime context cache
-- Latest build moved/changed the old WorldManager AOB target. Cache the
-- live entity-list context from the area traversal hook instead.
-- ================================================================
local mem_player_obj = allocateMemory(8)
local mem_hash_table = allocateMemory(8)
local mem_cam_kind = allocateMemory(4)
writeQword(mem_player_obj, 0)
writeQword(mem_hash_table, 0)
writeInteger(mem_cam_kind, 0)
registerSymbol("AT_PLAYER_OBJ", mem_player_obj, true)
registerSymbol("AT_HASH_TABLE", mem_hash_table, true)
registerSymbol("AT_CAM_KIND", mem_cam_kind, true)

-- ================================================================
-- Dynamic globals: AT_DESC_MASK + AT_QUEUE
-- ================================================================
local patDQ = "E8 ?? ?? ?? ?? 44 8B 05 ?? ?? ?? ?? 0F B7 54 24 ?? E8 ?? ?? ?? ?? 4C 8B 25"
local resDQ = AOBScan(patDQ, "+X-C-W", 0, base, base + modSize)
if not resDQ or resDQ.Count == 0 then
  if resDQ then resDQ.destroy() end
  error("[AutoLoot] AT_DESC_MASK/AT_QUEUE AOB not found")
end
local matchDQ = tonumber("0x" .. resDQ[0])
resDQ.destroy()
local addr_desc_mask = resolveRIP(matchDQ + 5, 7, 3)
local addr_queue = resolveRIP(matchDQ + 22, 7, 3)
if not addr_desc_mask then error("[AutoLoot] AT_DESC_MASK resolve failed") end
if not addr_queue then error("[AutoLoot] AT_QUEUE resolve failed") end
registerSymbol("AT_DESC_MASK", addr_desc_mask, true)
registerSymbol("AT_QUEUE", addr_queue, true)

-- ================================================================
-- Dynamic global: AT_ITEM_MGR (ItemInfoManager singleton)
-- ================================================================
local patIM = "56 57 41 56 48 83 EC 40 0F B7 39 48 8B 1D ?? ?? ?? ?? 3B 7B 08"
local resIM = AOBScan(patIM, "+X-C-W", 0, base, base + modSize)
if not resIM or resIM.Count == 0 then
  if resIM then resIM.destroy() end
  error("[AutoLoot] AT_ITEM_MGR AOB not found")
end

local function isUserPtr(addr)
  if not addr or addr == 0 then return false end
  return (0x800000000000 &gt; addr)
end

local function scoreMgrCandidate(global_addr)
  local mgr_ptr = readQword(global_addr)
  if not mgr_ptr or mgr_ptr == 0 then return -1, 0 end
  local count = readInteger(mgr_ptr + 8)
  if not count or 1 &gt; count then return -1, 0 end
  local arr = readQword(mgr_ptr + 0x50)
  if not arr or arr == 0 then return -1, count end
  local score = 0
  local n = math.min(count, 30)
  local start = math.max(1, math.floor(count / 4))
  for j = 0, n - 1 do
    local idx = start + j
    if idx &gt;= count then break end
    local item = readQword(arr + idx * 8)
    if item and isUserPtr(item) then
      local pcnt = readInteger(item + 0x280)
      if pcnt ~= nil and pcnt &gt;= 0 and 20 &gt;= pcnt then
        local parr = readQword(item + 0x278)
        if pcnt == 0 and (parr == nil or parr == 0) then
          score = score + 1
        elseif pcnt &gt; 0 and parr and isUserPtr(parr) then
          score = score + 3
        end
      end
    end
  end
  return score, count
end

local best_mgr = nil
local best_score = -1
local best_count = 0
local candidates_log = {}
for i = 0, resIM.Count - 1 do
  local m = tonumber("0x" .. resIM[i])
  local candidate = resolveRIP(m + 11, 7, 3)
  if candidate then
    local score, count = scoreMgrCandidate(candidate)
    table.insert(candidates_log,
      string.format("  [%d] %X count=%d score=%d%s",
        i, candidate, count, score,
        (score &gt; best_score) and " *" or ""))
    if score &gt; best_score then
      best_score = score
      best_count = count
      best_mgr = candidate
    end
  end
end
resIM.destroy()
if not best_mgr then error("[AutoLoot] AT_ITEM_MGR resolve failed") end
registerSymbol("AT_ITEM_MGR", best_mgr, true)

-- ================================================================
-- [v5.0] AOB 8: sub_1406B2450 (area-loot hook - entity traversal)
-- ================================================================
local pat_area = "55 41 54 41 55 41 56 41 57 48 8B EC 48 83 EC 50 C5 F8 29 74 24 40 4D 8B ?? 8B ?? 48 8B ??"
local res_area = AOBScan(pat_area, "+X-C-W", 0, base, base + modSize)
if not res_area or res_area.Count == 0 then
  if res_area then res_area.destroy() end
  error("[AutoLoot] Area-loot hook AOB not found")
end
local area_match = tonumber("0x" .. res_area[0])
res_area.destroy()
local area_hook = area_match - 0x0F
local area_ret  = area_hook + 0x0F
registerSymbol("AT_AREA_HOOK", area_hook, true)
registerSymbol("AT_AREA_RET",  area_ret,  true)

-- ================================================================
-- [v5.0] Area-loot control variables
-- ================================================================
local mem_area_on  = allocateMemory(4)
local mem_dedup_rs = allocateMemory(4)
writeInteger(mem_area_on, 1)     -- 0=camera mode (v4.4), 1=area-loot mode
writeInteger(mem_dedup_rs, 0)    -- dedup reset trigger
registerSymbol("AT_AREA_ON",      mem_area_on,  true)
registerSymbol("AT_DEDUP_RESET",  mem_dedup_rs, true)

-- [v5.0] Player-drop filter: skip items dropped by the player
local mem_npd = allocateMemory(4)
writeInteger(mem_npd, 0)  -- 0 = pick up player drops (default), 1 = skip
registerSymbol("AT_NO_PLAYER_DROP", mem_npd, true)

print(string.format("[AutoLoot v7.0] hook=%X ret=%X merge=%X hash=%X getpos=%X",
      hook_addr, ret_addr, merge, fn_hash_lookup, fn_get_pos))
print(string.format("[AutoLoot v7.0] QUEUE=%X DESC_MASK=%X ITEM_MGR=%X (count=%d score=%d)",
      addr_queue, addr_desc_mask, best_mgr, best_count, best_score))
print(string.format("[AutoLoot v7.0] context_cache PLAYER=%X HASH=%X", mem_player_obj, mem_hash_table))
print(string.format("[AutoLoot v7.0] area_hook=%X area_ret=%X", area_hook, area_ret))
print("[AutoLoot v7.0] ITEM_MGR candidates:")
for _, s in ipairs(candidates_log) do print(s) end

-- ================================================================
-- VEH for camera price_check safety (same as v4.4)
-- ================================================================
local function setupVEH()
  local pc_start = getAddressSafe("price_check")
  local pc_end   = getAddressSafe("price_ok")
  if not pc_start or not pc_end then
    print("[AutoLoot] VEH: labels not ready, skipping")
    return
  end
  local veh_script = string.format([=[
    alloc(AT_VEH_CODE, 128)
    registersymbol(AT_VEH_CODE)
    label(veh_pass)
    AT_VEH_CODE:
      sub rsp, 28
      mov rax, [rcx]
      cmp dword ptr [rax], C0000005
      jne veh_pass
      mov rdx, [rcx+8]
      mov rax, [rdx+F8]
      mov rcx, %X
      cmp rax, rcx
      jb veh_pass
      mov rcx, %X
      cmp rax, rcx
      jae veh_pass
      mov rcx, %X
      mov [rdx+F8], rcx
      mov eax, FFFFFFFF
      add rsp, 28
      ret
    veh_pass:
      xor eax, eax
      add rsp, 28
      ret
  ]=], pc_start, pc_end, pc_end)
  local ok = autoAssemble(veh_script)
  if not ok then
    print("[AutoLoot] VEH assembly failed")
    return
  end

  local veh_addr = getAddressSafe("AT_VEH_CODE")
  local addVEH = getAddress("kernel32.AddVectoredExceptionHandler")
  if veh_addr and addVEH then
    local handle = executeCodeEx(0, nil, addVEH, 1, veh_addr)
    local mem = allocateMemory(8)
    writeQword(mem, handle)
    registerSymbol("AT_VEH_HANDLE", mem, true)
    print(string.format("[AutoLoot v7.0] VEH registered: handler=%X handle=%X", veh_addr, handle))
  end
end

local veh_timer = createTimer(nil)
veh_timer.Interval = 100
veh_timer.OnTimer = function(t)
  t.Enabled = false
  t.destroy()
  setupVEH()
end
veh_timer.Enabled = true

{$asm}

// ============================================================
//  Camera Auto-Loot Cave (v6.0: added TypeID=0xF gather)
// ============================================================
alloc(cave, 12288)
alloc(orig, 32)

orig:
  readmem(AT_HOOK2, 0x11)

label(not_autoloot)
label(do_search)
label(check_take)
label(check_gather)
label(do_take)
label(do_take_plant_payload)
label(do_take_payload_done)
label(check_catch)
label(do_catch)
label(camera_fallback)
label(camera_fb_not_insect)
label(camera_fb_not_search)
label(camera_fb_maybe_plant)
label(camera_fb_store)
label(camera_fb_restore)
label(camera_fb_dispatch)
label(camera_fb_dispatch_search)
label(camera_fb_dispatch_take)
label(camera_fb_dispatch_gather)
label(camera_fb_dispatch_catch)
label(camera_fb_dispatch_search_2)
label(camera_fb_dispatch_take_2)
label(camera_fb_dispatch_gather_2)
label(camera_fb_dispatch_catch_2)
label(camera_fb_burst_fail)
label(camera_fb_burst_ok)
label(enqueue_event)
label(alloc_failed)
label(price_check)
label(price_ok)
label(camera_task_2c8_ok)
label(skip_item)
label(price_loop)
label(load_camera_eid)
label(load_camera_eid_legacy)
label(load_camera_eid_ptr)
label(load_camera_eid_done)

registersymbol(price_check)
registersymbol(price_ok)

cave:
  // [v7.0/1573] Capture camera context (delivered in rsi by the new hook)
  // into r14, which the cave never clobbers. load_camera_eid reads [r14+180].
  // r14 is dead in the original code between hook and merge, and autoloot
  // paths jmp to AT_MERGE which reassigns r14, so this is safe on both paths.
  mov r14, rsi

  // ---- Master switch ----
  push rax
  mov rax, AT_ENABLED
  cmp dword ptr [rax], 0
  pop rax
  je not_autoloot

  // ---- [v5.0] Skip camera mode if area-loot active ----
  push rax
  mov rax, AT_AREA_ON
  cmp dword ptr [rax], 0
  pop rax
  jne not_autoloot

  push rax
  mov rax, AT_CAM_KIND
  mov dword ptr [rax], 0
  pop rax

  // ---- TypeID dispatch ----
  cmp word ptr [r13+10], 1
  jne check_take

  // -- Search path: check enabled + burst limit --
  push rax
  mov rax, AT_SEARCH_ON
  cmp dword ptr [rax], 0
  pop rax
  je not_autoloot
  push rax
  push rcx
  mov rax, AT_BURST_COUNT
  mov ecx, [rax]
  mov rax, AT_BURST_MAX
  cmp ecx, [rax]
  pop rcx
  pop rax
  jge not_autoloot
  jmp do_search

check_take:
  cmp word ptr [r13+10], 4
  jne check_gather

  push rax
  mov rax, AT_TAKE_ON
  cmp dword ptr [rax], 0
  pop rax
  je not_autoloot
  push rax
  push rcx
  mov rax, AT_BURST_COUNT
  mov ecx, [rax]
  mov rax, AT_BURST_MAX
  cmp ecx, [rax]
  pop rcx
  pop rax
  jge not_autoloot
  jmp price_check

// ============================================================
//  [v6.0] Camera gather: TypeID=0xF (plant)
// ============================================================
check_gather:
  cmp word ptr [r13+10], 0F
  jne check_catch

  push rax
  mov rax, AT_GATHER_ON
  cmp dword ptr [rax], 0
  pop rax
  je not_autoloot
  push rax
  push rcx
  mov rax, AT_BURST_COUNT
  mov ecx, [rax]
  mov rax, AT_BURST_MAX
  cmp ecx, [rax]
  pop rcx
  pop rax
  jge not_autoloot
  jmp do_take                // skip price_check; do_take switches to plant payload for TypeID=0xF

// ============================================================
//  [v6.0] Camera catch: TypeID=0x18 (insect)
// ============================================================
check_catch:
  cmp word ptr [r13+10], 18
  jne camera_fallback

  push rax
  mov rax, AT_CATCH_ON
  cmp dword ptr [rax], 0
  pop rax
  je not_autoloot
  push rax
  push rcx
  mov rax, AT_BURST_COUNT
  mov ecx, [rax]
  mov rax, AT_BURST_MAX
  cmp ecx, [rax]
  pop rcx
  pop rax
  jge not_autoloot
  jmp do_catch

// ============================================================
//  Camera fallback classifier
//  If interaction IDs changed, classify the current target entity directly.
// ============================================================
camera_fallback:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  push rbx
  push rsi
  push rdi
  push rbp
  mov rbp, rsp
  and rsp, FFFFFFFFFFFFFFF0
  sub rsp, 20

  mov rax, AT_CAM_KIND
  mov dword ptr [rax], 0

  call load_camera_eid
  test eax, eax
  jz camera_fb_restore
  mov edx, eax

  mov rax, AT_HASH_TABLE
  mov rcx, [rax]
  test rcx, rcx
  jz camera_fb_restore
  mov rax, AT_HASH_LOOKUP
  call rax
  test rax, rax
  jz camera_fb_restore
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz camera_fb_restore
  mov rsi, rax

  mov r8, [rsi+68]
  test r8, r8
  jz camera_fb_restore
  mov r10, r8
  shr r10, 2F
  test r10, r10
  jnz camera_fb_restore

  mov r9, [r8+20]
  test r9, r9
  jz camera_fb_restore
  mov r10, r9
  shr r10, 2F
  test r10, r10
  jnz camera_fb_restore

  mov rax, [rsi+88]
  test rax, rax
  jz camera_fb_restore
  movzx ebx, byte ptr [rax+1]

  // Insect catch: entity_type==3 and comp+0x2C8==9.
  cmp bl, 3
  jne camera_fb_not_insect
  cmp byte ptr [r9+2C8], 9
  jne camera_fb_not_insect
  mov eax, 18
  jmp camera_fb_store

camera_fb_not_insect:
  // Corpse search.
  cmp byte ptr [r9+273], 1
  jne camera_fb_not_search
  mov eax, 1
  jmp camera_fb_store

camera_fb_not_search:
  mov r10, [r8+30]
  test r10, r10
  jz camera_fb_restore
  mov r11, r10
  shr r11, 2F
  test r11, r11
  jnz camera_fb_restore

  cmp bl, 7
  jne camera_fb_restore
  cmp qword ptr [r10+C0], 0
  je camera_fb_maybe_plant

  // Item take.
  cmp byte ptr [r10+3E2], 1
  je camera_fb_restore
  cmp byte ptr [r9+2C8], 0F
  je camera_fb_restore
  cmp byte ptr [r9+2C8], 11
  je camera_fb_restore
  mov eax, 4
  jmp camera_fb_store

camera_fb_maybe_plant:
  cmp qword ptr [r10+E0], 0
  je camera_fb_restore
  mov eax, 0F

camera_fb_store:
  mov rdx, AT_CAM_KIND
  mov [rdx], eax

camera_fb_restore:
  mov rsp, rbp
  pop rbp
  pop rdi
  pop rsi
  pop rbx
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  pop rax

camera_fb_dispatch:
  push rcx
  mov rcx, AT_CAM_KIND
  mov ecx, [rcx]
  cmp ecx, 1
  je camera_fb_dispatch_search
  cmp ecx, 4
  je camera_fb_dispatch_take
  cmp ecx, 0F
  je camera_fb_dispatch_gather
  cmp ecx, 18
  je camera_fb_dispatch_catch
  pop rcx
  jmp not_autoloot

camera_fb_dispatch_search:
  pop rcx
  push rax
  mov rax, AT_SEARCH_ON
  cmp dword ptr [rax], 0
  pop rax
  je not_autoloot
  jmp camera_fb_burst_ok

camera_fb_dispatch_take:
  pop rcx
  push rax
  mov rax, AT_TAKE_ON
  cmp dword ptr [rax], 0
  pop rax
  je not_autoloot
  push rcx
  mov rcx, AT_CAM_KIND
  mov dword ptr [rcx], 4
  pop rcx
  jmp camera_fb_burst_ok

camera_fb_dispatch_gather:
  pop rcx
  push rax
  mov rax, AT_GATHER_ON
  cmp dword ptr [rax], 0
  pop rax
  je not_autoloot
  push rcx
  mov rcx, AT_CAM_KIND
  mov dword ptr [rcx], 0F
  pop rcx
  jmp camera_fb_burst_ok

camera_fb_dispatch_catch:
  pop rcx
  push rax
  mov rax, AT_CATCH_ON
  cmp dword ptr [rax], 0
  pop rax
  je not_autoloot
  jmp camera_fb_burst_ok

camera_fb_burst_ok:
  push rax
  push rcx
  mov rax, AT_BURST_COUNT
  mov ecx, [rax]
  mov rax, AT_BURST_MAX
  cmp ecx, [rax]
  pop rcx
  pop rax
  jge camera_fb_burst_fail

  push rcx
  mov rcx, AT_CAM_KIND
  mov ecx, [rcx]
  cmp ecx, 1
  je camera_fb_dispatch_search_2
  cmp ecx, 4
  je camera_fb_dispatch_take_2
  cmp ecx, 0F
  je camera_fb_dispatch_gather_2
  cmp ecx, 18
  je camera_fb_dispatch_catch_2
  pop rcx
  jmp not_autoloot

camera_fb_dispatch_search_2:
  pop rcx
  jmp do_search
camera_fb_dispatch_take_2:
  pop rcx
  jmp price_check
camera_fb_dispatch_gather_2:
  pop rcx
  jmp do_take
camera_fb_dispatch_catch_2:
  pop rcx
  jmp do_catch

camera_fb_burst_fail:
  jmp not_autoloot

not_autoloot:
  // [v7.0/1573] reproduce 17 stolen bytes: type-byte->r15d, context in rsi.
  movzx r15d, byte ptr [rax+66]
  mov rax, [rsi]
  mov rcx, rsi
  call qword ptr [rax+108]
  jmp AT_RET

// ============================================================
//  Camera price_check (same as v5.4)
// ============================================================
price_check:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  push rbx
  push rsi
  push rdi
  push rbp
  mov rbp, rsp
  and rsp, FFFFFFFFFFFFFFF0
  sub rsp, 30

  call load_camera_eid
  mov edx, eax
  test edx, edx
  jz price_ok

  mov rax, AT_HASH_TABLE
  mov rcx, [rax]
  test rcx, rcx
  jz price_ok

  mov rax, AT_HASH_LOOKUP
  call rax
  test rax, rax
  jz price_ok
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz price_ok

  mov rax, [rax+68]
  test rax, rax
  jz price_ok
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz price_ok
  mov rsi, rax
  mov rax, [rsi+30]
  test rax, rax
  jz price_ok
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz price_ok
  mov rbx, rax

  // [v6.2] Quest/script-bound instance filter: comp+2C8 == 1.
  mov r10, [rsi+20]
  test r10, r10
  jz camera_task_2c8_ok
  mov r11, r10
  shr r11, 2F
  test r11, r11
  jnz camera_task_2c8_ok
  cmp byte ptr [r10+2C8], 1
  je skip_item
camera_task_2c8_ok:

  mov rax, [rbx+C0]
  test rax, rax
  jz price_ok
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz price_ok
  movzx ecx, word ptr [rax+8]

  mov rax, AT_MIN_PRICE
  cmp dword ptr [rax], 0
  je price_ok

  mov rax, AT_ITEM_MGR
  mov rax, [rax]
  test rax, rax
  jz price_ok
  cmp ecx, [rax+8]
  jae price_ok
  mov rax, [rax+50]
  test rax, rax
  jz price_ok
  mov rax, [rcx*8+rax]
  test rax, rax
  jz price_ok
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz price_ok

  mov edx, [rax+280]
  cmp edx, 0
  je price_ok
  cmp edx, 14
  ja price_ok
  mov rsi, [rax+278]
  test rsi, rsi
  jz price_ok
  mov r10, rsi
  shr r10, 2F
  test r10, r10
  jnz price_ok

  xor edi, edi
price_loop:
  mov rax, [rsi+8]
  cmp rax, rdi
  cmova rdi, rax
  add rsi, 18
  dec edx
  jnz price_loop

  mov rax, AT_MIN_PRICE
  mov eax, [rax]
  cmp rdi, rax
  jb skip_item

price_ok:
  mov rsp, rbp
  pop rbp
  pop rdi
  pop rsi
  pop rbx
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  pop rax
  jmp do_take

skip_item:
  mov rsp, rbp
  pop rbp
  pop rdi
  pop rsi
  pop rbx
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  pop rax
  jmp AT_MERGE

// v1.0.0.1573 camera target:
// [r14+0x180] holds the server entity EID (offset unchanged from 978; context
// captured from rsi into r14 at cave entry). The older UI-row path below now
// usually returns a camera-internal key (0xFFxxxxxx); keep it only as a
// fallback. Legacy field offsets shifted in 1573: 20D->21D, 210->224, 1E0->1F0.
load_camera_eid:
  mov eax, [r14+180]
  test eax, eax
  jz load_camera_eid_legacy
  cmp eax, FF000000
  jb load_camera_eid_done

load_camera_eid_legacy:
  xor eax, eax
  cmp byte ptr [rdi+21D], 0
  je load_camera_eid_ptr
  mov eax, [rdi+224]
  ret
load_camera_eid_ptr:
  mov rcx, [rdi+1F0]
  test rcx, rcx
  je load_camera_eid_done
  mov eax, [rcx+2C]
load_camera_eid_done:
  ret

// ============================================================
//  Camera do_search (same as v5.4)
// ============================================================
do_search:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  push rbx
  push rsi
  push rbp
  mov rbp, rsp
  and rsp, FFFFFFFFFFFFFFF0
  sub rsp, 30

  call load_camera_eid
  test eax, eax
  jz alloc_failed
  mov [rsp+20], eax

  mov rax, AT_PLAYER_OBJ
  mov rax, [rax]
  test rax, rax
  jz alloc_failed
  mov ebx, [rax+60]
  test ebx, ebx
  jz alloc_failed
  mov esi, [rax+58]

  mov rax, AT_TLS_INIT
  call rax
  mov edx, 07E8
  mov rax, AT_DESC_MASK
  mov r8d, [rax]
  mov rax, AT_DESC_LOOKUP
  call rax
  test rax, rax
  jz alloc_failed
  mov [rsp+28], rax

  mov edx, 07
  mov rax, AT_ALLOC_EVENT
  call rax
  test rax, rax
  jz alloc_failed

  mov dword ptr [rax+30], 1
  mov dword ptr [rax+40], 0
  mov qword ptr [rax+48], 0
  mov [rax+50], ebx
  mov dword ptr [rax+54], 0
  mov [rax+58], esi
  mov rcx, [rsp+28]
  mov [rax+60], rcx
  mov word ptr [rax+68], 0007
  mov byte ptr [rax+78], 1

  mov rdx, [rax+70]
  mov byte ptr [rdx+0], E8
  mov byte ptr [rdx+1], 07
  mov byte ptr [rdx+2], FF
  mov ecx, [rsp+20]
  mov [rdx+3], ecx

  jmp enqueue_event

// ============================================================
//  Camera do_take (v1573 desc 0x0809; plant TypeID=0xF uses same format)
// ============================================================
do_take:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  push rbx
  push rsi
  push rbp
  mov rbp, rsp
  and rsp, FFFFFFFFFFFFFFF0
  sub rsp, 30

  call load_camera_eid
  test eax, eax
  jz alloc_failed
  mov [rsp+20], eax

  mov rax, AT_PLAYER_OBJ
  mov rax, [rax]
  test rax, rax
  jz alloc_failed
  mov ebx, [rax+60]
  test ebx, ebx
  jz alloc_failed
  mov esi, [rax+58]

  mov rax, AT_TLS_INIT
  call rax
  mov edx, 0809
  mov rax, AT_DESC_MASK
  mov r8d, [rax]
  mov rax, AT_DESC_LOOKUP
  call rax
  test rax, rax
  jz alloc_failed
  mov [rsp+28], rax

  mov edx, 0D
  mov rax, AT_ALLOC_EVENT
  call rax
  test rax, rax
  jz alloc_failed

  mov dword ptr [rax+30], 1
  mov dword ptr [rax+40], 0
  mov qword ptr [rax+48], 0
  mov [rax+50], ebx
  mov dword ptr [rax+54], 0
  mov [rax+58], esi
  mov rcx, [rsp+28]
  mov [rax+60], rcx
  mov word ptr [rax+68], 000D
  mov byte ptr [rax+78], 1

  mov rdx, [rax+70]
  mov dword ptr [rdx+0], 00FF0809
  mov ecx, [rsp+20]
  mov [rdx+4], ecx
  mov dword ptr [rdx+8], FF000101
  mov byte ptr [rdx+0C], 0
  // [v7.0/1573] Gather now uses the SAME event format as Take (verified via
  // x64dbg: gather enqueues desc 0x0809 / 00FF0809 / FF000101, no mode byte).
  // The 978 mode=5 divergence is gone; do_take_plant_payload kept as no-op.
  cmp word ptr [r13+10], 0F
  je do_take_plant_payload
  push rax
  mov rax, AT_CAM_KIND
  cmp dword ptr [rax], 0F
  pop rax
  jne do_take_payload_done
do_take_plant_payload:
  mov dword ptr [rdx+0], 00FF0809
  mov dword ptr [rdx+8], FF000101
do_take_payload_done:

  jmp enqueue_event

// ============================================================
//  Camera do_catch (v1.0.0.1573 catch event)
//  desc_id=0800, buffer=8 bytes
// ============================================================
do_catch:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  push rbx
  push rsi
  push rbp
  mov rbp, rsp
  and rsp, FFFFFFFFFFFFFFF0
  sub rsp, 40

  call load_camera_eid
  test eax, eax
  jz alloc_failed
  mov [rsp+20], eax

  mov rax, AT_PLAYER_OBJ
  mov rax, [rax]
  test rax, rax
  jz alloc_failed
  mov ebx, [rax+60]
  test ebx, ebx
  jz alloc_failed
  mov esi, [rax+58]

  mov rax, AT_TLS_INIT
  call rax
  mov edx, 0800
  mov rax, AT_DESC_MASK
  mov r8d, [rax]
  mov rax, AT_DESC_LOOKUP
  call rax
  test rax, rax
  jz alloc_failed
  mov [rsp+28], rax

  mov edx, 08
  mov rax, AT_ALLOC_EVENT
  call rax
  test rax, rax
  jz alloc_failed

  mov dword ptr [rax+30], 1
  mov dword ptr [rax+40], 0
  mov qword ptr [rax+48], 0
  mov [rax+50], ebx
  mov dword ptr [rax+54], 0
  mov [rax+58], ebx             // Catch routing uses player EID, not route/session
  mov rcx, [rsp+28]
  mov [rax+60], rcx
  mov word ptr [rax+68], 0008
  mov byte ptr [rax+78], 1

  mov rdx, [rax+70]
  mov byte ptr [rdx+0], 00
  mov byte ptr [rdx+1], 08
  mov byte ptr [rdx+2], FF
  mov ecx, [rsp+20]
  mov [rdx+3], ecx              // target insect EID
  mov byte ptr [rdx+7], 03       // catch action byte observed in sub_1423C15A0

  jmp enqueue_event

// ============================================================
//  Camera enqueue + cleanup (same as v5.4)
// ============================================================
enqueue_event:
  mov rdx, rax
  mov rax, AT_QUEUE
  mov rcx, [rax]
  mov r8, [rsp+28]
  xor r9d, r9d
  mov rax, AT_ENQUEUE
  call rax
  mov rax, AT_BURST_COUNT
  lock inc dword ptr [rax]

alloc_failed:
  mov rsp, rbp
  pop rbp
  pop rsi
  pop rbx
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  pop rax
  jmp AT_MERGE

// ============================================================
//  Install camera hook
// ============================================================
AT_HOOK2:
  // [v7.0] 17-byte steal: 14-byte absolute jump stub + 3-byte NOP pad.
  // FF 25 00000000 jumps through the qword immediately after it.
  db FF 25 00 00 00 00
  dq cave
  db 90 90 90

// ============================================================
//  Area Auto-Loot Cave - v6.0
//
//  v6.0: Added plant hash-table scan (when entity_index==4).
//  Plants are type-7 entities with itemdata==NULL, chardata!=NULL,
//  found in [entity_list_obj+8] hash table but not in +0x110 array.
// ============================================================
alloc(area_cave, 16384)
alloc(area_orig, 16)
alloc(dedup_data, 8192)
alloc(area_lock, 4)

area_orig:
  readmem(AT_AREA_HOOK, 0xF)

label(area_gate_fail)
label(area_skip)
label(area_dedup_scan)
label(area_dedup_pass)
label(area_classify)
label(area_check_item)
label(area_do_search)
label(area_do_take)
label(area_task_2c8_ok)
label(area_take_price_ok)
label(area_price_loop)
label(area_enqueue)
label(area_dedup_add)
label(area_dedup_add_done)
label(area_done)
label(area_pdrop_ok)
label(area_range_ok)

// [v6.0] Plant scan labels
label(area_plant_scan)
label(area_plant_scan_return)
label(area_skip_plant)
label(plant_bucket_loop)
label(plant_entry_loop)
label(plant_next_entry)
label(plant_next_bucket)
label(plant_dedup_scan)
label(plant_dedup_pass)
label(plant_range_ok)
label(plant_range_unlimited)
label(plant_count_ok)
label(plant_dedup_lock)
label(plant_dedup_add_done2)

// [v6.0] Insect scan labels
label(area_no_hash_scan)
label(area_skip_insect)
label(area_insect_scan)
label(area_insect_scan_return)
label(insect_bucket_loop)
label(insect_entry_loop)
label(insect_next_entry)
label(insect_next_bucket)
label(insect_dedup_scan)
label(insect_dedup_pass)
label(insect_range_ok)
label(insect_range_unlimited)
label(insect_count_ok)
label(insect_dedup_lock)
label(insect_dedup_add_done)

area_cave:
  // --- Replaced prologue (15 bytes) ---
  mov [rsp+08], rbx
  mov [rsp+10], rsi
  mov [rsp+18], rdi

  // Cache live entity-list context for camera mode and event routing.
  push rax
  push r10
  mov rax, AT_HASH_TABLE
  mov r10, [rcx+08]
  mov [rax], r10
  mov rax, AT_PLAYER_OBJ
  mov r10, [rcx+20]
  mov [rax], r10
  pop r10
  pop rax

  // --- Quick gate checks ---
  push rax
  mov rax, AT_ENABLED
  cmp dword ptr [rax], 0
  je area_gate_fail
  mov rax, AT_AREA_ON
  cmp dword ptr [rax], 0
  je area_gate_fail
  pop rax

  // Only normal entities (index &gt;= 4)
  cmp edx, 4
  jb area_skip

  // === Save registers ===
  push rax
  push rbx
  push rcx
  push rdx
  push rsi
  push rdi
  push r8
  push r9
  push r10
  push r11
  push rbp
  mov rbp, rsp
  sub rsp, 80

  // --- Burst limit check ---
  mov rax, AT_BURST_COUNT
  mov ecx, [rax]
  mov rax, AT_BURST_MAX
  cmp ecx, [rax]
  jge area_done

  // === [v6.0+] Hash-table scans (only for first entity) ===
  cmp dword ptr [rbp+38], 4
  jne area_no_hash_scan

  // [v6.0] Plant scan
  mov rax, AT_GATHER_ON
  cmp dword ptr [rax], 0
  je area_skip_plant
  jmp area_plant_scan
area_plant_scan_return:
area_skip_plant:

  // [v6.0] Insect scan
  mov rax, AT_CATCH_ON
  cmp dword ptr [rax], 0
  je area_skip_insect
  jmp area_insect_scan
area_insect_scan_return:
area_skip_insect:

area_no_hash_scan:

  // --- Get entity from stack-saved params (thread-safe) ---
  mov rax, [rbp+40]
  mov rax, [rax+110]
  test rax, rax
  jz area_done
  mov ecx, dword ptr [rbp+38]
  sub ecx, 4
  shl rcx, 3
  add rax, rcx
  mov rsi, [rax]
  test rsi, rsi
  jz area_done
  mov r10, rsi
  shr r10, 2F
  test r10, r10
  jnz area_done

  // Entity ID
  mov ebx, [rsi+60]
  test ebx, ebx
  jz area_done

  // --- Dedup check (lockless read, benign race) ---
  mov rdi, dedup_data
  mov eax, [rdi]
  test eax, eax
  jz area_dedup_pass
  add rdi, 8
area_dedup_scan:
  cmp [rdi], ebx
  je area_done
  add rdi, 4
  dec eax
  jnz area_dedup_scan
area_dedup_pass:

  // === [v5.1] Range filter (3D distance) ===
  mov rax, AT_LOOT_RANGE
  mov eax, [rax]
  test eax, eax
  jz area_range_ok

  mov rax, [rbp+40]
  mov rax, [rax+20]
  test rax, rax
  jz area_done
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz area_done

  mov r10, [rax+68]
  test r10, r10
  jz area_done
  mov r10, [r10+1A0]
  test r10, r10
  jz area_done

  mov rcx, rax
  lea rdx, [rsp+30]
  mov rax, AT_GET_POS
  call rax

  mov r10, [rsi+68]
  test r10, r10
  jz area_done
  mov r10, [r10+1A0]
  test r10, r10
  jz area_done

  mov rcx, rsi
  lea rdx, [rsp+40]
  mov rax, AT_GET_POS
  call rax

  movss xmm0, [rsp+40]
  subss xmm0, [rsp+30]
  mulss xmm0, xmm0
  movss xmm1, [rsp+44]
  subss xmm1, [rsp+34]
  mulss xmm1, xmm1
  addss xmm0, xmm1
  movss xmm1, [rsp+48]
  subss xmm1, [rsp+38]
  mulss xmm1, xmm1
  addss xmm0, xmm1

  mov rax, AT_LOOT_RANGE
  movss xmm1, [rax]
  mulss xmm1, xmm1
  comiss xmm0, xmm1
  ja area_done

area_range_ok:

  // --- Classification ---
area_classify:
  mov rax, [rsi+68]
  test rax, rax
  jz area_done
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz area_done
  mov r8, rax

  // Dead check FIRST
  mov rax, [r8+20]
  test rax, rax
  jz area_check_item
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz area_check_item
  cmp byte ptr [rax+273], 1
  je area_do_search

  // [v5.4] Item filter
area_check_item:
  mov rcx, [r8+30]
  test rcx, rcx
  jz area_done
  mov r10, rcx
  shr r10, 2F
  test r10, r10
  jnz area_done

  // [v6.2] Quest/script-bound instance filter: comp+2C8 == 1.
  mov r10, [r8+20]
  test r10, r10
  jz area_task_2c8_ok
  mov r11, r10
  shr r11, 2F
  test r11, r11
  jnz area_task_2c8_ok
  cmp byte ptr [r10+2C8], 1
  je area_done
area_task_2c8_ok:

  // [v6.2] i3E2 filter
  cmp byte ptr [rcx+3E2], 1
  je area_done

  // [v6.2] comp2C8 filter
  mov rax, [r8+20]
  test rax, rax
  jz area_done
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz area_done
  cmp byte ptr [rax+2C8], 0F
  je area_done
  cmp byte ptr [rax+2C8], 11
  je area_done

  // item_data = [intermediate+C0]
  mov rdx, [rcx+C0]
  test rdx, rdx
  jz area_done

  // [v5.4] Player-drop filter
  push rax
  mov rax, AT_NO_PLAYER_DROP
  cmp dword ptr [rax], 0
  pop rax
  je area_pdrop_ok
  mov rax, [r8+20]
  test rax, rax
  jz area_pdrop_ok
  cmp byte ptr [rax+2C8], 16
  je area_done
area_pdrop_ok:

  jmp area_do_take

  // === CORPSE -&gt; Search ===
area_do_search:
  mov rax, AT_SEARCH_ON
  cmp dword ptr [rax], 0
  je area_done

  mov rax, [rbp+40]
  mov rax, [rax+20]
  test rax, rax
  jz area_done
  mov ecx, [rax+60]
  test ecx, ecx
  jz area_done
  mov [rsp+20], ecx
  mov ecx, [rax+58]
  mov [rsp+24], ecx

  mov rax, AT_TLS_INIT
  call rax
  mov edx, 07E8
  mov rax, AT_DESC_MASK
  mov r8d, [rax]
  mov rax, AT_DESC_LOOKUP
  call rax
  test rax, rax
  jz area_done
  mov [rsp+28], rax

  mov edx, 07
  mov rax, AT_ALLOC_EVENT
  call rax
  test rax, rax
  jz area_done

  mov dword ptr [rax+30], 1
  mov dword ptr [rax+40], 0
  mov qword ptr [rax+48], 0
  mov ecx, [rsp+20]
  mov [rax+50], ecx
  mov dword ptr [rax+54], 0
  mov ecx, [rsp+24]
  mov [rax+58], ecx
  mov rcx, [rsp+28]
  mov [rax+60], rcx
  mov word ptr [rax+68], 0007
  mov byte ptr [rax+78], 1

  mov rdx, [rax+70]
  mov byte ptr [rdx+0], E8
  mov byte ptr [rdx+1], 07
  mov byte ptr [rdx+2], FF
  mov [rdx+3], ebx

  jmp area_enqueue

  // === ITEM -&gt; Take ===
area_do_take:
  mov rax, AT_TAKE_ON
  cmp dword ptr [rax], 0
  je area_done

  // Price filter
  mov rax, AT_MIN_PRICE
  cmp dword ptr [rax], 0
  je area_take_price_ok

  mov r10, rdx
  shr r10, 2F
  test r10, r10
  jnz area_take_price_ok
  movzx ecx, word ptr [rdx+8]

  mov rax, AT_ITEM_MGR
  mov rax, [rax]
  test rax, rax
  jz area_take_price_ok
  cmp ecx, [rax+8]
  jae area_take_price_ok
  mov rax, [rax+50]
  test rax, rax
  jz area_take_price_ok
  shl rcx, 3
  add rax, rcx
  mov rax, [rax]
  test rax, rax
  jz area_take_price_ok
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz area_take_price_ok

  mov edx, [rax+280]
  cmp edx, 0
  je area_take_price_ok
  cmp edx, 14
  ja area_take_price_ok
  mov rsi, [rax+278]
  test rsi, rsi
  jz area_take_price_ok
  mov r10, rsi
  shr r10, 2F
  test r10, r10
  jnz area_take_price_ok

  xor edi, edi
area_price_loop:
  mov rax, [rsi+8]
  cmp rax, rdi
  cmova rdi, rax
  add rsi, 18
  dec edx
  jnz area_price_loop

  mov rax, AT_MIN_PRICE
  mov eax, [rax]
  cmp rdi, rax
  jb area_done

area_take_price_ok:
  // Session info
  mov rax, [rbp+40]
  mov rax, [rax+20]
  test rax, rax
  jz area_done
  mov ecx, [rax+60]
  test ecx, ecx
  jz area_done
  mov [rsp+20], ecx
  mov ecx, [rax+58]
  mov [rsp+24], ecx

  mov rax, AT_TLS_INIT
  call rax
  mov edx, 0809
  mov rax, AT_DESC_MASK
  mov r8d, [rax]
  mov rax, AT_DESC_LOOKUP
  call rax
  test rax, rax
  jz area_done
  mov [rsp+28], rax

  mov edx, 0D
  mov rax, AT_ALLOC_EVENT
  call rax
  test rax, rax
  jz area_done

  mov dword ptr [rax+30], 1
  mov dword ptr [rax+40], 0
  mov qword ptr [rax+48], 0
  mov ecx, [rsp+20]
  mov [rax+50], ecx
  mov dword ptr [rax+54], 0
  mov ecx, [rsp+24]
  mov [rax+58], ecx
  mov rcx, [rsp+28]
  mov [rax+60], rcx
  mov word ptr [rax+68], 000D
  mov byte ptr [rax+78], 1

  mov rdx, [rax+70]
  mov dword ptr [rdx+0], 00FF0809
  mov [rdx+4], ebx
  mov dword ptr [rdx+8], FF000101
  mov byte ptr [rdx+0C], 0

// --- Shared enqueue ---
area_enqueue:
  mov rdx, rax
  mov rax, AT_QUEUE
  mov rcx, [rax]
  mov r8, [rsp+28]
  xor r9d, r9d
  mov rax, AT_ENQUEUE
  call rax

  mov rax, AT_BURST_COUNT
  lock inc dword ptr [rax]

  // --- Add to dedup (spinlock protected, circular buffer) ---
area_dedup_add:
  mov eax, 1
  xchg dword ptr [area_lock], eax
  test eax, eax
  jnz area_dedup_add

  mov rdi, dedup_data
  mov eax, [rdi+4]
  shl eax, 2
  lea rdi, [rdi+rax+8]
  mov [rdi], ebx

  mov rdi, dedup_data
  mov eax, [rdi+4]
  inc eax
  and eax, 3FF
  mov [rdi+4], eax

  mov eax, [rdi]
  cmp eax, 400
  jge area_dedup_add_done
  inc dword ptr [rdi]

area_dedup_add_done:
  mov dword ptr [area_lock], 0

area_done:
  mov rsp, rbp
  pop rbp
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdi
  pop rsi
  pop rdx
  pop rcx
  pop rbx
  pop rax

area_skip:
  jmp AT_AREA_RET

area_gate_fail:
  pop rax
  jmp AT_AREA_RET


// ============================================================
//  [v6.0] Plant hash-table scan
//
//  Iterates [entity_list_obj+8] hash table to find plant entities.
//  Plants: type==7, [intermediate+C0]==NULL, [intermediate+E0]!=NULL.
//  Uses stack for loop state, shares dedup/burst/enqueue with main path.
//
//  Stack layout (rsp+50..7F used for plant scan):
//    [rsp+50]: bucket_count (dword)
//    [rsp+54]: bucket_idx (dword)
//    [rsp+58]: bucket_array (qword)
//    [rsp+60]: value_array (qword)
//    [rsp+68]: entry_count in current bucket (dword)
//    [rsp+6C]: entry_idx in current bucket (dword)
//    [rsp+70]: current bucket_ptr (qword)
//    [rsp+78]: reserved
//    [rsp+30..3B]: player pos (from range check)
//    [rsp+40..4B]: entity pos (temp)
//    [rsp+20..28]: session info + descriptor (reused for enqueue)
// ============================================================
area_plant_scan:
  // Get hash table from entity_list_obj
  mov rax, [rbp+40]
  mov rdi, [rax+8]
  test rdi, rdi
  jz area_plant_scan_return
  mov r10, rdi
  shr r10, 2F
  test r10, r10
  jnz area_plant_scan_return

  // Read hash table metadata
  mov eax, [rdi+60]
  test eax, eax
  jz area_plant_scan_return
  cmp eax, 1000
  ja area_plant_scan_return
  mov [rsp+50], eax

  mov rax, [rdi+70]
  test rax, rax
  jz area_plant_scan_return
  mov [rsp+58], rax

  mov rax, [rdi+78]
  test rax, rax
  jz area_plant_scan_return
  mov [rsp+60], rax

  // Get player position for range check
  mov rax, AT_LOOT_RANGE
  mov eax, [rax]
  test eax, eax
  jz plant_range_unlimited

  mov rax, [rbp+40]
  mov rax, [rax+20]
  test rax, rax
  jz area_plant_scan_return
  mov r10, [rax+68]
  test r10, r10
  jz area_plant_scan_return
  mov r10, [r10+1A0]
  test r10, r10
  jz area_plant_scan_return
  mov rcx, rax
  lea rdx, [rsp+30]
  mov rax, AT_GET_POS
  call rax

plant_range_unlimited:
  // Initialize bucket loop
  mov dword ptr [rsp+54], 0

plant_bucket_loop:
  // Check burst limit before each bucket
  mov rax, AT_BURST_COUNT
  mov ecx, [rax]
  mov rax, AT_BURST_MAX
  cmp ecx, [rax]
  jge area_plant_scan_return

  mov eax, [rsp+54]
  cmp eax, [rsp+50]
  jge area_plant_scan_return

  // bucket_ptr = bucket_array + bucket_idx * 256
  mov rdi, [rsp+58]
  mov eax, [rsp+54]
  shl eax, 8
  add rdi, rax
  mov [rsp+70], rdi

  // entry_count (cap at 30 for safety)
  mov eax, [rdi]
  test eax, eax
  jz plant_next_bucket
  cmp eax, 1E
  jbe plant_count_ok
  mov eax, 1E
plant_count_ok:
  mov [rsp+68], eax
  mov dword ptr [rsp+6C], 0

plant_entry_loop:
  mov eax, [rsp+6C]
  cmp eax, [rsp+68]
  jge plant_next_bucket

  // Get entity_id and slot_index from bucket
  mov rdi, [rsp+70]
  mov eax, [rsp+6C]
  shl eax, 3
  add eax, 8
  mov ebx, [rdi+rax]
  mov ecx, [rdi+rax+4]

  // Look up entity from value_array
  mov rax, [rsp+60]
  mov rax, [rax+rcx*8]
  test rax, rax
  jz plant_next_entry
  cmp [rax+4], ebx
  jne plant_next_entry
  mov rsi, [rax+8]
  test rsi, rsi
  jz plant_next_entry
  mov r10, rsi
  shr r10, 2F
  test r10, r10
  jnz plant_next_entry

  // Verify entity_id
  cmp [rsi+60], ebx
  jne plant_next_entry

  // === Plant criteria ===
  // entity_type == 7 ?
  mov rax, [rsi+88]
  test rax, rax
  jz plant_next_entry
  cmp byte ptr [rax+1], 7
  jne plant_next_entry

  // sub_obj = [entity+68]
  mov rax, [rsi+68]
  test rax, rax
  jz plant_next_entry
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz plant_next_entry
  mov r8, rax

  // intermediate = [sub_obj+30]
  mov rax, [r8+30]
  test rax, rax
  jz plant_next_entry
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz plant_next_entry

  // itemdata = [intermediate+C0] must be NULL
  cmp qword ptr [rax+C0], 0
  jne plant_next_entry

  // chardata = [intermediate+E0] must be non-NULL
  cmp qword ptr [rax+E0], 0
  je plant_next_entry

  // === Dedup check ===
  mov rdi, dedup_data
  mov eax, [rdi]
  test eax, eax
  jz plant_dedup_pass
  add rdi, 8
plant_dedup_scan:
  cmp [rdi], ebx
  je plant_next_entry
  add rdi, 4
  dec eax
  jnz plant_dedup_scan
plant_dedup_pass:

  // === Distance check ===
  mov rax, AT_LOOT_RANGE
  mov eax, [rax]
  test eax, eax
  jz plant_range_ok

  mov r10, [rsi+68]
  test r10, r10
  jz plant_next_entry
  mov r10, [r10+1A0]
  test r10, r10
  jz plant_next_entry
  mov rcx, rsi
  lea rdx, [rsp+40]
  mov rax, AT_GET_POS
  call rax

  movss xmm0, [rsp+40]
  subss xmm0, [rsp+30]
  mulss xmm0, xmm0
  movss xmm1, [rsp+44]
  subss xmm1, [rsp+34]
  mulss xmm1, xmm1
  addss xmm0, xmm1
  movss xmm1, [rsp+48]
  subss xmm1, [rsp+38]
  mulss xmm1, xmm1
  addss xmm0, xmm1

  mov rax, AT_LOOT_RANGE
  movss xmm1, [rax]
  mulss xmm1, xmm1
  comiss xmm0, xmm1
  ja plant_next_entry

plant_range_ok:
  // === Enqueue latest plant gather event (desc 0x0809, same as Take) ===
  mov rax, [rbp+40]
  mov rax, [rax+20]
  test rax, rax
  jz plant_next_entry
  mov ecx, [rax+60]
  test ecx, ecx
  jz plant_next_entry
  mov [rsp+20], ecx
  mov ecx, [rax+58]
  mov [rsp+24], ecx

  mov rax, AT_TLS_INIT
  call rax
  mov edx, 0809
  mov rax, AT_DESC_MASK
  mov r8d, [rax]
  mov rax, AT_DESC_LOOKUP
  call rax
  test rax, rax
  jz plant_next_entry
  mov [rsp+28], rax

  mov edx, 0D
  mov rax, AT_ALLOC_EVENT
  call rax
  test rax, rax
  jz plant_next_entry

  mov dword ptr [rax+30], 1
  mov dword ptr [rax+40], 0
  mov qword ptr [rax+48], 0
  mov ecx, [rsp+20]
  mov [rax+50], ecx
  mov dword ptr [rax+54], 0
  mov ecx, [rsp+24]
  mov [rax+58], ecx
  mov rcx, [rsp+28]
  mov [rax+60], rcx
  mov word ptr [rax+68], 000D
  mov byte ptr [rax+78], 1

  mov rdx, [rax+70]
  // [v7.0/1573] Plant gather uses the SAME event as Take (desc 0x0809,
  // 00FF0809 / FF000101). The 978 mode=5 (05FF0807 / FF010000) is gone.
  mov dword ptr [rdx+0], 00FF0809
  mov [rdx+4], ebx
  mov dword ptr [rdx+8], FF000101
  mov byte ptr [rdx+0C], 0

  // Enqueue
  mov rdx, rax
  mov rax, AT_QUEUE
  mov rcx, [rax]
  mov r8, [rsp+28]
  xor r9d, r9d
  mov rax, AT_ENQUEUE
  call rax

  mov rax, AT_BURST_COUNT
  lock inc dword ptr [rax]

  // Add to dedup
  mov eax, 1
plant_dedup_lock:
  xchg dword ptr [area_lock], eax
  test eax, eax
  jnz plant_dedup_lock

  mov rdi, dedup_data
  mov eax, [rdi+4]
  shl eax, 2
  lea rdi, [rdi+rax+8]
  mov [rdi], ebx

  mov rdi, dedup_data
  mov eax, [rdi+4]
  inc eax
  and eax, 3FF
  mov [rdi+4], eax

  mov eax, [rdi]
  cmp eax, 400
  jge plant_dedup_add_done2
  inc dword ptr [rdi]

plant_dedup_add_done2:
  mov dword ptr [area_lock], 0

plant_next_entry:
  inc dword ptr [rsp+6C]
  jmp plant_entry_loop

plant_next_bucket:
  inc dword ptr [rsp+54]
  jmp plant_bucket_loop


// ============================================================
//  [v6.0] Insect hash-table scan
//
//  Iterates [entity_list_obj+8] hash table to find insect entities.
//  Insects: entity_type==3, comp+0x2C8==9 (catch interaction class).
//  Reuses same stack layout as plant scan (rsp+50..78).
// ============================================================
area_insect_scan:
  // Get hash table from entity_list_obj
  mov rax, [rbp+40]
  mov rdi, [rax+8]
  test rdi, rdi
  jz area_insect_scan_return
  mov r10, rdi
  shr r10, 2F
  test r10, r10
  jnz area_insect_scan_return

  // Read hash table metadata
  mov eax, [rdi+60]
  test eax, eax
  jz area_insect_scan_return
  cmp eax, 1000
  ja area_insect_scan_return
  mov [rsp+50], eax

  mov rax, [rdi+70]
  test rax, rax
  jz area_insect_scan_return
  mov [rsp+58], rax

  mov rax, [rdi+78]
  test rax, rax
  jz area_insect_scan_return
  mov [rsp+60], rax

  // Get player position for range check
  mov rax, AT_LOOT_RANGE
  mov eax, [rax]
  test eax, eax
  jz insect_range_unlimited

  mov rax, [rbp+40]
  mov rax, [rax+20]
  test rax, rax
  jz area_insect_scan_return
  mov r10, [rax+68]
  test r10, r10
  jz area_insect_scan_return
  mov r10, [r10+1A0]
  test r10, r10
  jz area_insect_scan_return
  mov rcx, rax
  lea rdx, [rsp+30]
  mov rax, AT_GET_POS
  call rax

insect_range_unlimited:
  // Initialize bucket loop
  mov dword ptr [rsp+54], 0

insect_bucket_loop:
  // Check burst limit before each bucket
  mov rax, AT_BURST_COUNT
  mov ecx, [rax]
  mov rax, AT_BURST_MAX
  cmp ecx, [rax]
  jge area_insect_scan_return

  mov eax, [rsp+54]
  cmp eax, [rsp+50]
  jge area_insect_scan_return

  // bucket_ptr = bucket_array + bucket_idx * 256
  mov rdi, [rsp+58]
  mov eax, [rsp+54]
  shl eax, 8
  add rdi, rax
  mov [rsp+70], rdi

  // entry_count (cap at 30 for safety)
  mov eax, [rdi]
  test eax, eax
  jz insect_next_bucket
  cmp eax, 1E
  jbe insect_count_ok
  mov eax, 1E
insect_count_ok:
  mov [rsp+68], eax
  mov dword ptr [rsp+6C], 0

insect_entry_loop:
  mov eax, [rsp+6C]
  cmp eax, [rsp+68]
  jge insect_next_bucket

  // Get entity_id and slot_index from bucket
  mov rdi, [rsp+70]
  mov eax, [rsp+6C]
  shl eax, 3
  add eax, 8
  mov ebx, [rdi+rax]
  mov ecx, [rdi+rax+4]

  // Look up entity from value_array
  mov rax, [rsp+60]
  mov rax, [rax+rcx*8]
  test rax, rax
  jz insect_next_entry
  cmp [rax+4], ebx
  jne insect_next_entry
  mov rsi, [rax+8]
  test rsi, rsi
  jz insect_next_entry
  mov r10, rsi
  shr r10, 2F
  test r10, r10
  jnz insect_next_entry

  // Verify entity_id
  cmp [rsi+60], ebx
  jne insect_next_entry

  // === Insect criteria ===
  // entity_type == 3 ?
  mov rax, [rsi+88]
  test rax, rax
  jz insect_next_entry
  cmp byte ptr [rax+1], 3
  jne insect_next_entry

  // sub_obj = [entity+68]
  mov rax, [rsi+68]
  test rax, rax
  jz insect_next_entry
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz insect_next_entry
  mov r8, rax

  // comp = [sub_obj+20]
  mov rax, [r8+20]
  test rax, rax
  jz insect_next_entry
  mov r10, rax
  shr r10, 2F
  test r10, r10
  jnz insect_next_entry

  // comp+0x2C8 == 9 (insect catch interaction class)
  cmp byte ptr [rax+2C8], 9
  jne insect_next_entry

  // === Dedup check ===
  mov rdi, dedup_data
  mov eax, [rdi]
  test eax, eax
  jz insect_dedup_pass
  add rdi, 8
insect_dedup_scan:
  cmp [rdi], ebx
  je insect_next_entry
  add rdi, 4
  dec eax
  jnz insect_dedup_scan
insect_dedup_pass:

  // === Distance check ===
  mov rax, AT_LOOT_RANGE
  mov eax, [rax]
  test eax, eax
  jz insect_range_ok

  mov r10, [rsi+68]
  test r10, r10
  jz insect_next_entry
  mov r10, [r10+1A0]
  test r10, r10
  jz insect_next_entry
  mov rcx, rsi
  lea rdx, [rsp+40]
  mov rax, AT_GET_POS
  call rax

  movss xmm0, [rsp+40]
  subss xmm0, [rsp+30]
  mulss xmm0, xmm0
  movss xmm1, [rsp+44]
  subss xmm1, [rsp+34]
  mulss xmm1, xmm1
  addss xmm0, xmm1
  movss xmm1, [rsp+48]
  subss xmm1, [rsp+38]
  mulss xmm1, xmm1
  addss xmm0, xmm1

  mov rax, AT_LOOT_RANGE
  movss xmm1, [rax]
  mulss xmm1, xmm1
  comiss xmm0, xmm1
  ja insect_next_entry

insect_range_ok:
  // === Enqueue Catch event for insect ===
  mov rax, [rbp+40]
  mov rax, [rax+20]
  test rax, rax
  jz insect_next_entry
  mov ecx, [rax+60]
  test ecx, ecx
  jz insect_next_entry
  mov [rsp+20], ecx
  // Catch routing uses player EID, not the normal route/session field.
  mov [rsp+24], ecx

  mov rax, AT_TLS_INIT
  call rax
  mov edx, 0800
  mov rax, AT_DESC_MASK
  mov r8d, [rax]
  mov rax, AT_DESC_LOOKUP
  call rax
  test rax, rax
  jz insect_next_entry
  mov [rsp+28], rax

  mov edx, 08
  mov rax, AT_ALLOC_EVENT
  call rax
  test rax, rax
  jz insect_next_entry

  mov dword ptr [rax+30], 1
  mov dword ptr [rax+40], 0
  mov qword ptr [rax+48], 0
  mov ecx, [rsp+20]
  mov [rax+50], ecx
  mov dword ptr [rax+54], 0
  mov ecx, [rsp+24]
  mov [rax+58], ecx             // Catch routing uses player EID
  mov rcx, [rsp+28]
  mov [rax+60], rcx
  mov word ptr [rax+68], 0008
  mov byte ptr [rax+78], 1

  mov rdx, [rax+70]
  mov byte ptr [rdx+0], 00
  mov byte ptr [rdx+1], 08
  mov byte ptr [rdx+2], FF
  mov [rdx+3], ebx              // target insect EID
  mov byte ptr [rdx+7], 03       // catch action byte observed in sub_1423C15A0

  // Enqueue
  mov rdx, rax
  mov rax, AT_QUEUE
  mov rcx, [rax]
  mov r8, [rsp+28]
  xor r9d, r9d
  mov rax, AT_ENQUEUE
  call rax

  mov rax, AT_BURST_COUNT
  lock inc dword ptr [rax]

  // Add to dedup
  mov eax, 1
insect_dedup_lock:
  xchg dword ptr [area_lock], eax
  test eax, eax
  jnz insect_dedup_lock

  mov rdi, dedup_data
  mov eax, [rdi+4]
  shl eax, 2
  lea rdi, [rdi+rax+8]
  mov [rdi], ebx

  mov rdi, dedup_data
  mov eax, [rdi+4]
  inc eax
  and eax, 3FF
  mov [rdi+4], eax

  mov eax, [rdi]
  cmp eax, 400
  jge insect_dedup_add_done
  inc dword ptr [rdi]

insect_dedup_add_done:
  mov dword ptr [area_lock], 0

insect_next_entry:
  inc dword ptr [rsp+6C]
  jmp insect_entry_loop

insect_next_bucket:
  inc dword ptr [rsp+54]
  jmp insect_bucket_loop


// ============================================================
//  Install area-loot hook (replace 15 bytes at function entry)
// ============================================================
AT_AREA_HOOK:
  // 15-byte absolute jump stub, safe even when area_cave is outside +/-2GB.
  db FF 25 00 00 00 00
  dq area_cave
  db 90


[DISABLE]
{$asm}
AT_HOOK2:
  readmem(orig, 0x11)

AT_AREA_HOOK:
  readmem(area_orig, 0xF)


</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>11</ID>
              <Description>"[v7.0] Skip AutoLoot Steal Penalty (Items + Plants)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>// Patch 1: Patches jz -&gt; jmp at the steal gate in sub_1423752F0 (v7.0/1573)
  // sub_142007490 returns al=1 for stealable items -&gt; normally enters steal path
  // This patch forces the jump to always skip the steal path
  // Effect: picking up NPC-owned items no longer triggers contribution loss
  //
  // Patch 2: NOP jnz at steal check in sub_142284F40 (v7.0/1573)
  // Plant gathering calls sub_142007490 from a different path (sub_142284F40)
  // al=1 -&gt; jnz -&gt; marks item as stealable -&gt; steal consequence event -&gt; contribution loss
  // NOP the jnz so plant gathering never triggers steal penalty

  [ENABLE]
  aobscanmodule(STEAL_BYPASS, CrimsonDesert.exe, 4D 8B C5 49 8B D7 48 8B 89 20 01 00 00 E8 ?? ?? ?? ?? 84 C0 74 ?? B3 02)
  registersymbol(STEAL_BYPASS)
  aobscanmodule(STEAL_BYPASS2, CrimsonDesert.exe, 4D 8B CD 4D 8B C4 E8 ?? ?? ?? ?? 84 C0 75 ?? 32 DB)
  registersymbol(STEAL_BYPASS2)

  STEAL_BYPASS+14:
    db EB

  STEAL_BYPASS2+D:
    db 90 90

  [DISABLE]
  STEAL_BYPASS+14:
    db 74

  STEAL_BYPASS2+D:
    db 75 4F

  unregistersymbol(STEAL_BYPASS)
  unregistersymbol(STEAL_BYPASS2)

</AssemblerScript>
