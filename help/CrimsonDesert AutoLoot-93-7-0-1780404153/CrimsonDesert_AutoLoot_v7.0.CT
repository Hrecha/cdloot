local res9 = AOBScan(pat9, "+X-C-W", 0, base, base + modSize)
if not res9 or res9.Count == 0 then
  if res9 then res9.destroy() end
  error("[AutoLoot] sub_14130C830 (GetWorldPos) AOB not found")
