-- AOB 2: sub_141018980 (TLS init)
-- ================================================================
local pat2 = "48 83 EC 28 BA 9C 00 00 00 65 48 8B 04 25 58 00 00 00 48 8B 08 8B 04 0A 39 05 ?? ?? ?? ?? 7E ?? 48 8D 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 83 3D ?? ?? ?? ?? FF 75 ?? 48 8D 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 90 48 8D 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 8D 05 ?? ?? ?? ?? 48 83 C4 28 C3 CC CC CC CC CC CC 40 56 45 33 C9 44 0F B7 D2"
local res2 = AOBScan(pat2, "+X-C-W", 0, base, base + modSize)
if not res2 or res2.Count == 0 then
  if res2 then res2.destroy() end
  error("[AutoLoot] sub_141018980 AOB not found")
end
local fn_tls_init = tonumber("0x" .. res2[0])
res2.destroy()
registerSymbol("AT_TLS_INIT", fn_tls_init, true)

