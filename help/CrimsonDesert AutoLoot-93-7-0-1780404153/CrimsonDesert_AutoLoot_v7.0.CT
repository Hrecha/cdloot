local pat10 = "48 89 5C 24 10 48 89 6C 24 18 56 57 41 56 48 83 EC 40 0F B7 39 48 8B 1D ?? ?? ?? ?? 3B 7B 08"
local res10 = AOBScan(pat10, "+X-C-W", 0, base, base + modSize)
