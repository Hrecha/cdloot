      <CheatEntries>
        <CheatEntry>
          <ID>1</ID>
          <Description>"Auto Loot"</Description>
          <Options moHideChildren="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local base = getAddress("CrimsonDesert.exe")
if not base then error("[AutoLoot] Module not found") end
local modSize = getModuleSize("CrimsonDesert.exe")

-- ================================================================
-- AOB 1: Hook point (type-byte load) - Camera auto-loot
-- ================================================================
-- [v7.0/1573] Camera hook restructured: type-byte now lands in r15d (was esi),
-- context object now in rsi (was r14). Stolen region is 17 bytes (was 16).
local pat = "?? 0F B6 ?? 66 48 8B ?? 48 8B ?? FF 90 08 01 00 00"
local res = AOBScan(pat, "+X-C-W", 0, base, base + modSize)
if not res or res.Count == 0 then
  if res then res.destroy() end
  error("[AutoLoot] Hook AOB not found")
end
local H2 = tonumber("0x" .. res[0])
res.destroy()
local hook_addr = H2
-- The camera hook must be long enough for a 14-byte absolute jump when CE
-- cannot allocate a cave within +/-2GB of CrimsonDesert.exe.
-- [v7.0] 17-byte steal (14-byte jmp + 3 NOP pad); ret = hook + 0x11.
local ret_addr  = H2 + 0x11
registerSymbol("AT_HOOK2", hook_addr, true)
registerSymbol("AT_RET",   ret_addr,  true)

-- ================================================================
-- AOB 6: Merge point (after timer store area)
-- ================================================================
-- [v7.0/1573] Merge point. v1573 这条指令寄存器对调(mov r14,[rsi+D0]; mov rax,[r14+D0])，
-- 特征码随之改变。AT_MERGE 仅作 jmp 目标(不偷取字节)，cave 退出前已恢复 rsi。
local pat6 = "4C 8B ?? D0 00 00 00 49 8B ?? D0 00 00 00"
local res6 = AOBScan(pat6, "+X-C-W", 0, base, base + modSize)
if not res6 or res6.Count == 0 then
  if res6 then res6.destroy() end
  error("[AutoLoot] Merge AOB not found")
end
local merge = tonumber("0x" .. res6[0])
res6.destroy()
registerSymbol("AT_MERGE", merge, true)

