// ---------------------------------------------------------------- лог -------

static HANDLE g_log = INVALID_HANDLE_VALUE;
static CRITICAL_SECTION g_logCs;
static bool g_logReady = false;

static void L(const char *fmt, ...) {
    if (!g_logReady) return;
    char buf[2048]; DWORD wr; SYSTEMTIME st; GetLocalTime(&st);
    EnterCriticalSection(&g_logCs);
    int n = sprintf(buf, "[%02u:%02u:%02u.%03u] ", st.wHour, st.wMinute, st.wSecond, st.wMilliseconds);
    va_list ap; va_start(ap, fmt);
    n += vsnprintf(buf + n, sizeof buf - n - 3, fmt, ap);
    va_end(ap);
    buf[n++] = 13; buf[n++] = 10; buf[n] = 0;
    if (g_log != INVALID_HANDLE_VALUE) WriteFile(g_log, buf, n, &wr, 0);
    LeaveCriticalSection(&g_logCs);
}

// ------------------------------------------------------------- модуль игры --

struct Module { unsigned char *base; size_t size; };
static Module g_game;

static unsigned char *aob(const char *name, const char *pattern) {
    unsigned char bytes[160]; char mask[160]; int len = 0;
    for (const char *p = pattern; *p && len < 160; ) {
        if (*p == ' ') { p++; continue; }
        if (*p == '?') { bytes[len] = 0; mask[len] = '?'; len++; p += (p[1] == '?') ? 2 : 1; }
        else { char h[3] = { p[0], p[1], 0 };
               bytes[len] = (unsigned char)strtoul(h, 0, 16); mask[len] = 'x'; len++; p += 2; }
    }
    unsigned char *found = 0; int hits = 0;
    unsigned char *end = g_game.base + g_game.size - len;
    for (unsigned char *cur = g_game.base; cur < end; cur++) {
        int i = 0;
        for (; i < len; i++) if (mask[i] == 'x' && cur[i] != bytes[i]) break;
        if (i == len) { if (!hits) found = cur; if (++hits > 1) break; }
    }
    if (hits == 1) { L("[aob] %-14s = +0x%llX", name, (unsigned long long)(found - g_game.base)); return found; }
    L("[aob] %-14s НЕ НАЙДЕНА (совпадений: %d)", name, hits);
    return 0;
}

struct GameFns {
    unsigned char *tlsInit, *descLookup, *allocEvent, *enqueue, *areaFn, *ownCheck, *getPos;
    uint32_t *descMask;      // маска таблицы дескрипторов
    void    **queue;         // очередь событий
} g_fn;

// Достаёт адрес из инструкции с rip-относительной адресацией.
static void *rip_target(unsigned char *insn, int dispOff, int insnLen) {
    int32_t rel = *(int32_t *)(insn + dispOff);
    return insn + insnLen + rel;
}

static bool resolve_functions() {
    unsigned char *tlsDesc = aob("tls+desc",
        "48 83 EC 28 BA 9C 00 00 00 65 48 8B 04 25 58 00 00 00 48 8B 08 8B 04 0A 39 05 ?? ?? ?? ?? "
        "7E ?? 48 8D 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 83 3D ?? ?? ?? ?? FF 75 ?? 48 8D 0D ?? ?? ?? ?? "
        "E8 ?? ?? ?? ?? 90 48 8D 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 8D 05 ?? ?? ?? ?? 48 83 C4 28 C3 "
        "CC CC CC CC CC CC 40 56 45 33 C9 44 0F B7 D2");
    if (tlsDesc) { g_fn.tlsInit = tlsDesc; g_fn.descLookup = tlsDesc + 0x60; }
    g_fn.allocEvent = aob("alloc_event",
        "48 89 5C 24 ?? 4C 89 44 24 ?? 57 48 83 EC 20 8B ?? BA ?? ?? 00 00");
    g_fn.enqueue = aob("enqueue",
        "48 89 5C 24 08 57 48 83 EC 20 48 8B ?? 38 65 48 8B 04 25 58 00 00 00");
    // Сигнатура попадает на 0xF байт внутрь тела функции - её начало лежит
    // раньше. Проверяем, что там действительно пролог, а не случайные байты.
    unsigned char *areaHit = aob("area_sweep",
        "55 41 54 41 55 41 56 41 57 48 8B EC 48 83 EC 50 C5 F8 29 74 24 40 4D 8B ?? 44 8B ?? 48 8B ??");
    if (areaHit) {
        unsigned char *start = areaHit - 0x0F;
        L("[aob] area_sweep начало = +0x%llX (байты %02X %02X %02X)",
          (unsigned long long)(start - g_game.base), start[0], start[1], start[2]);
        g_fn.areaFn = start;
    }
    // Эти две функции перехватывает AutoLoot: если он загружен, их прологи
    // изменены и сигнатура не совпадёт. Для разработки CDLoot его лучше убрать.
    g_fn.ownCheck = aob("own_check",
        "48 89 5C 24 08 48 89 74 24 10 48 89 7C 24 18 55 41 54 41 55 41 56 41 57 48 8B EC "
        "48 81 EC 80 00 00 00 49 8B F0 4C 8B FA");
    g_fn.getPos = aob("get_pos",
        "40 53 48 83 EC 50 48 8B 41 68 48 8B 88 ?? 01 00 00 48 8B 01");
    // DESC_MASK и очередь берём из кода, а не зашиваем: они переезжают каждый патч.
    unsigned char *dq = aob("desc_mask+queue",
        "E8 ?? ?? ?? ?? 44 8B 05 ?? ?? ?? ?? 0F B7 54 24 ?? E8 ?? ?? ?? ?? 4C 8B 25");
    if (dq) {
        g_fn.descMask = (uint32_t *)rip_target(dq + 5, 3, 7);        // 44 8B 05 <rel32>
        unsigned char *q = dq + 21;                                   // 4C 8B 25 <rel32>
        g_fn.queue = (void **)rip_target(q, 3, 7);
        L("[aob] DESC_MASK = +0x%llX, очередь = +0x%llX",
          (unsigned long long)((unsigned char *)g_fn.descMask - g_game.base),
          (unsigned long long)((unsigned char *)g_fn.queue - g_game.base));
    }

    bool ok = g_fn.tlsInit && g_fn.allocEvent && g_fn.enqueue && g_fn.areaFn &&
              g_fn.descMask && g_fn.queue;
    L("[aob] итог: %s", ok ? "ключевые функции найдены" : "часть не найдена");
    return ok;
}

// ------------------------------------------------------ раскладка сущности --

// Раскладка по заметкам стороннего автора (проверена им на 1573, сверена
// нами на 2474: идентификатор и номера событий совпали до байта).
#define ENT_ROUTE      0x58    // route / session id
#define ENT_EID        0x60    // идентификатор сущности
#define ENT_SUBOBJ     0x68    // -> sub_object
#define ENT_TYPEINFO   0x88    // [[+0x88]+1] = тип

#define SUB_COMP       0x20    // sub_obj -> comp
#define SUB_INTER      0x30    // sub_obj -> intermediate
#define SUB_TRANSFORM  0x1A0   // sub_obj -> transform
#define TF_POS         0xB4    // позиция внутри transform (2474)

#define COMP_DEAD      0x273   // ==1 -> труп, нужен обыск
#define COMP_CAT       0x2C8   // категория взаимодействия

#define INTER_ITEMDATA 0xC0
#define INTER_GATHER   0xE0
#define INTER_LOCKED   0x3E2

#define CTX_HASH       0x08
#define CTX_PLAYER     0x20    // <- ИГРОК
#define CTX_ARRAY      0x110

// категории взаимодействия
#define CAT_QUEST      0x01    // квестовое, не трогать
#define CAT_INSECT     0x09    // насекомые
#define CAT_SHOP       0x0F    // товар в лавке, не трогать
#define CAT_DECOR      0x11    // декорация, не трогать
#define CAT_PLAYERDROP 0x16    // выброшено игроком

static bool readable(const void *p, SIZE_T n) {
    MEMORY_BASIC_INFORMATION mbi;
    if (!VirtualQuery(p, &mbi, sizeof mbi)) return false;
    if (mbi.State != MEM_COMMIT) return false;
    if (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) return false;
    return (SIZE_T)((unsigned char *)mbi.BaseAddress + mbi.RegionSize - (unsigned char *)p) >= n;
}

// -------------------------------------------------- перехват со снятием -----
// Каждый перехват помнит, что лежало на месте до него. CoreStop возвращает
// байты обратно, и только после этого DLL можно выгружать.

struct Hook {
    unsigned char *site;        // начало перехваченной функции
    unsigned char orig[32];     // что там было
    int origLen;                // сколько байт мы забрали
    unsigned char *cave;        // наш переходник
    bool active;
};
static Hook g_areaHook = {};

static unsigned char *alloc_near(void *anchor) {
    SYSTEM_INFO si; GetSystemInfo(&si);
    uintptr_t a = (uintptr_t)anchor;
    for (uintptr_t d = si.dwAllocationGranularity; d < 0x60000000ull; d += si.dwAllocationGranularity) {
        for (int dir = 0; dir < 2; dir++) {
            uintptr_t t = dir ? a + d : a - d;
            void *m = VirtualAlloc((void *)(t & ~(uintptr_t)(si.dwAllocationGranularity - 1)),
                                   0x1000, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
            if (m) return (unsigned char *)m;
        }
    }
    return 0;
}

static bool write_code(void *dst, const void *src, size_t n) {
    DWORD old;
    if (!VirtualProtect(dst, n, PAGE_EXECUTE_READWRITE, &old)) return false;
    memcpy(dst, src, n);
    VirtualProtect(dst, n, old, &old);
    FlushInstructionCache(GetCurrentProcess(), dst, n);
    return true;
}

// ------------------------------------------------------- отправка события ---
// Порядок восстановлен разбором AutoLoot и сверен с чужими заметками.

typedef void  (__fastcall *FnTlsInit)();
typedef void *(__fastcall *FnDescLookup)(uint64_t zero, uint32_t descId, uint32_t mask);
typedef void *(__fastcall *FnAllocEvent)(uint64_t zero, uint32_t sizeCode);
typedef void  (__fastcall *FnEnqueue)(void *queueObj, void *ev, void *desc, uint64_t zero);

enum Action { ACT_SEARCH = 0, ACT_TAKE = 1, ACT_CATCH = 2 };

// номер события и размер буфера для каждого действия (версия 2474)
static uint16_t act_desc(Action a) {
    switch (a) { case ACT_SEARCH: return 0x07E8; case ACT_CATCH: return 0x0800; default: return 0x0809; }
}
static uint16_t act_size(Action a) {
    switch (a) { case ACT_SEARCH: return 7; case ACT_CATCH: return 8; default: return 0xD; }
}

static bool send_action(Action act, uint32_t targetEid, uint32_t playerEid, uint8_t mode) {
    if (!g_fn.tlsInit || !g_fn.descLookup || !g_fn.allocEvent || !g_fn.enqueue ||
        !g_fn.descMask || !g_fn.queue) return false;

    ((FnTlsInit)g_fn.tlsInit)();

    void *desc = ((FnDescLookup)g_fn.descLookup)(0, act_desc(act), *g_fn.descMask);
    if (!desc) { L("[send] дескриптор 0x%04X не найден", act_desc(act)); return false; }

    uint16_t size = act_size(act);
    void *ev = ((FnAllocEvent)g_fn.allocEvent)(0, size);
    if (!ev) { L("[send] не удалось выделить событие"); return false; }
    unsigned char *e = (unsigned char *)ev;

    *(uint32_t *)(e + 0x30) = 1;
    *(uint32_t *)(e + 0x40) = 0;
    *(uint64_t *)(e + 0x48) = 0;
    *(uint32_t *)(e + 0x50) = playerEid;
    *(uint32_t *)(e + 0x54) = 0;
    *(uint32_t *)(e + 0x58) = playerEid;      // route; для ловли это тоже player_eid
    *(void   **)(e + 0x60) = desc;
    *(uint16_t *)(e + 0x68) = size;
    *(uint8_t  *)(e + 0x78) = 1;

    unsigned char *buf = *(unsigned char **)(e + 0x70);
    if (!buf) { L("[send] у события нет буфера"); return false; }
    uint16_t id = act_desc(act);
    switch (act) {
        case ACT_SEARCH:                                  // E8 07 FF <eid>
            buf[0] = (uint8_t)(id & 0xFF); buf[1] = (uint8_t)(id >> 8); buf[2] = 0xFF;
            *(uint32_t *)(buf + 3) = targetEid;
            break;
        case ACT_CATCH:                                   // 00 08 FF <eid> .. 03
            buf[0] = (uint8_t)(id & 0xFF); buf[1] = (uint8_t)(id >> 8); buf[2] = 0xFF;
            *(uint32_t *)(buf + 3) = targetEid; buf[7] = 3;
            break;
        default:                                          // 09 08 FF <способ> <eid> 01 01 00 FF 00
            buf[0] = (uint8_t)(id & 0xFF); buf[1] = (uint8_t)(id >> 8); buf[2] = 0xFF;
            buf[3] = mode;                                // 0x00 обычный подбор, 0x04 из кармана
            *(uint32_t *)(buf + 4) = targetEid;
            buf[8] = 0x01; buf[9] = 0x01; buf[10] = 0x00; buf[11] = 0xFF; buf[12] = 0x00;
            break;
    }

    void *q = *g_fn.queue;
    if (!q) { L("[send] очередь пуста"); return false; }
    ((FnEnqueue)g_fn.enqueue)(q, ev, desc, 0);

    L("[send] отправлено: действие=%d eid=%08X desc=0x%04X размер=%u способ=0x%02X",
      (int)act, targetEid, id, size, mode);
    return true;
}

// ----------------------------------------------------------- логика мода ----

static volatile LONG g_scanRequested;
static volatile LONG g_takeRequested;
static volatile LONG g_running;

#define ENT_POS 0x220      // три float: мировая позиция
                          // найдено статистикой: 278 объектов из 471

struct Vec3 { float x, y, z; };
static Vec3 ent_pos(unsigned char *e) { return *(Vec3 *)(e + ENT_POS); }
static bool pos_valid(const Vec3 &v) {
    return v.x == v.x && v.y == v.y && v.z == v.z &&
           (v.x != 0.0f || v.z != 0.0f);
}

// Ищем сущность по идентификатору во всех списках контекста.
static unsigned char *find_by_eid(unsigned char *c, uint32_t want) {
    for (int off = 0x100; off + 16 <= 0x200; off += 8) {
        uint32_t count = *(uint32_t *)(c + off);
        uint32_t cap   = *(uint32_t *)(c + off + 4);
        uint64_t data  = *(uint64_t *)(c + off + 8);
        if (!count || !cap || count > cap || cap > 0x10000) continue;
        if (!data || !readable((void *)data, 8)) continue;
        unsigned char **arr = (unsigned char **)data;
        for (uint32_t i = 0; i < count && i < 4000; i++) {
            if (!readable(arr + i, 8)) break;
            unsigned char *e = arr[i];
            if (e && readable(e, 0x400) && *(uint32_t *)(e + ENT_EID) == want) return e;
        }
    }
    return 0;
}

// Снимок позиций для поиска подвижных объектов
struct Snap { uint32_t eid; Vec3 p; };
static Snap g_snap[2048];
static int  g_snapN;

// Мировая координата, а не локальная и не элемент таблицы констант.
// Локальные лежат в пределах пары тысяч, мировые - тысячи и десятки тысяч.
// Круглые числа вроде 1024 или 4096 отсекаем: это данные, а не позиции.
static bool round_number(float f) {
    float a = f < 0 ? -f : f;
    if (a != (float)(int)a) return false;          // не целое - точно не константа
    int i = (int)a;
    return (i % 16) == 0 && i >= 1024;              // 1024, 4096, 6400, 10000...
}
static bool world_pos(const Vec3 &q) {
    if (q.x != q.x || q.y != q.y || q.z != q.z) return false;
    float ax = q.x < 0 ? -q.x : q.x, az = q.z < 0 ? -q.z : q.z;
    if (ax < 2000.0f || ax > 100000.0f) return false;
    if (az < 2000.0f || az > 100000.0f) return false;
    if (q.y < -1000.0f || q.y > 8000.0f) return false;
    if (round_number(q.x) && round_number(q.y) && round_number(q.z)) return false;
    return true;
}

static void *deref(void *p, int off) {
    if (!p || !readable(p, off + 8)) return 0;
    void *v = *(void **)((unsigned char *)p + off);
    return (v && (uintptr_t)v > 0x10000 && (uintptr_t)v < 0x7FFFFFFFFFFF) ? v : 0;
}

extern "C" void __fastcall cdloot_on_area(void *ctx, void *a2, void *a3, void *a4) {
    (void)a2; (void)a3; (void)a4;
    if (!InterlockedCompareExchange(&g_scanRequested, 0, 0)) return;
    InterlockedExchange(&g_scanRequested, 0);
    if (!ctx || !readable(ctx, 0x200)) { L("[scan] контекст нечитаем"); return; }
    unsigned char *c = (unsigned char *)ctx;

    // Заметки сняты с версии 1573, у нас 2474 - смещение игрока могло уехать.
    // Ищем по признаку: объект с sub_object, у которого в transform лежат
    // настоящие мировые координаты. Это и есть игрок, где бы он ни лежал.
    L("[ctx] %p — перебираю поля в поисках игрока", ctx);
    void *me = 0; int meOff = -1; int meTf = -1;
    for (int off = 0; off < 0x200 && !me; off += 8) {
        void *cand = deref(c, off);
        if (!cand) continue;
        void *sub = deref(cand, ENT_SUBOBJ);
        if (!sub) continue;
        void *tf = deref(sub, SUB_TRANSFORM);
        if (!tf || !readable(tf, 0x200)) continue;
        unsigned char *t = (unsigned char *)tf;
        for (int q = 0; q + 12 <= 0x200; q += 4) {
            Vec3 v = *(Vec3 *)(t + q);
            if (v.x != v.x || v.z != v.z) continue;
            float ax = v.x < 0 ? -v.x : v.x, az = v.z < 0 ? -v.z : v.z;
            if (ax < 500.0f || ax > 100000.0f || az < 500.0f || az > 100000.0f) continue;
            L("[me] НАЙДЕН: ctx+0x%03X -> %p  eid=%08X", off, cand,
              readable(cand, ENT_EID + 4) ? *(uint32_t *)((unsigned char *)cand + ENT_EID) : 0);
            L("[me] transform %p, позиция по +0x%03X = (%.1f, %.1f, %.1f)", tf, q, v.x, v.y, v.z);
            me = cand; meOff = off; meTf = q;
            break;
        }
    }
    if (!me) { L("[me] игрока с координатами в контексте нет"); return; }
    (void)meOff; (void)meTf;

    // Позиция любой сущности - той же цепочкой, что и у игрока.
    // Система отсчёта общая, поэтому расстояния считаются честно.
    Vec3 mp{ 0, 0, 0 };
    {
        void *sub = deref(me, ENT_SUBOBJ);
        void *tf = sub ? deref(sub, SUB_TRANSFORM) : 0;
        if (tf && readable(tf, TF_POS + 12)) mp = *(Vec3 *)((unsigned char *)tf + TF_POS);
    }
    L("[me] позиция (%.1f, %.1f, %.1f)", mp.x, mp.y, mp.z);

    struct Near { uint32_t eid; float d; uint8_t cat; uint8_t dead; };
    Near nearby[40]; int nn = 0;
    int total = 0, withPos = 0;

    // Наш контекст - не тот entity_list из заметок (игрок лежит по +0x50, а не
    // по +0x20). Зато списки мы нашли сами: раскладка {количество, вместимость,
    // данные} в диапазоне +0x100..+0x200.
    for (int off = 0x100; off + 16 <= 0x200; off += 8) {
        uint32_t count = *(uint32_t *)(c + off);
        uint32_t cap   = *(uint32_t *)(c + off + 4);
        uint64_t data  = *(uint64_t *)(c + off + 8);
        if (!count || !cap || count > cap || cap > 0x10000) continue;
        if (!data || !readable((void *)data, 8)) continue;
        unsigned char **arr = (unsigned char **)data;
        for (uint32_t i = 0; i < count && i < 3000; i++) {
            if (!readable(arr + i, 8)) break;
            unsigned char *e = arr[i];
            if (!e || !readable(e, 0x100)) continue;
            uint32_t id = *(uint32_t *)(e + ENT_EID);
            if ((id >> 16) != 0xB010) continue;
            bool dup = false;
            for (int k = 0; k < nn; k++) if (nearby[k].eid == id) { dup = true; break; }
            if (dup) continue;
            total++;
            void *sub = deref(e, ENT_SUBOBJ);
            if (!sub) continue;
            void *tf = deref(sub, SUB_TRANSFORM);
            if (!tf || !readable(tf, TF_POS + 12)) continue;
            Vec3 q = *(Vec3 *)((unsigned char *)tf + TF_POS);
            if (q.x != q.x || q.z != q.z) continue;
            withPos++;
            float dx = q.x - mp.x, dy = q.y - mp.y, dz = q.z - mp.z;
            float d = (float)sqrt(dx * dx + dy * dy + dz * dz);
            if (d > 25.0f || nn >= 40) continue;
            uint8_t cat = 0, dead = 0;
            void *comp = deref(sub, SUB_COMP);
            if (comp && readable(comp, COMP_CAT + 1)) {
                cat  = *((unsigned char *)comp + COMP_CAT);
                dead = *((unsigned char *)comp + COMP_DEAD);
            }
            nearby[nn].eid = id; nearby[nn].d = d;
            nearby[nn].cat = cat; nearby[nn].dead = dead; nn++;
        }
    }
    L("[scan] в массиве %d объектов, с позицией %d, в радиусе 25 — %d", total, withPos, nn);

    // сортируем по дистанции, ближайшие первыми
    for (int a = 0; a < nn; a++)
        for (int b = a + 1; b < nn; b++)
            if (nearby[b].d < nearby[a].d) { Near t = nearby[a]; nearby[a] = nearby[b]; nearby[b] = t; }
    for (int i = 0; i < nn && i < 25; i++) {
        const char *what = "";
        switch (nearby[i].cat) {
            case CAT_QUEST:      what = "квестовое, не трогать"; break;
            case CAT_INSECT:     what = "насекомое"; break;
            case CAT_SHOP:       what = "товар в лавке"; break;
            case CAT_DECOR:      what = "декорация"; break;
            case CAT_PLAYERDROP: what = "выброшено игроком"; break;
            default:             what = nearby[i].dead == 1 ? "ТРУП, обыскать" : "предмет"; break;
        }
        L("   %5.1f  eid=%08X cat=0x%02X  %s", nearby[i].d, nearby[i].eid, nearby[i].cat, what);
    }

    // ---- взятие ближайшего по F8 ----
    if (!InterlockedCompareExchange(&g_takeRequested, 0, 0)) return;
    InterlockedExchange(&g_takeRequested, 0);

    uint32_t playerEid = readable(me, ENT_EID + 4)
                       ? *(uint32_t *)((unsigned char *)me + ENT_EID) : 0;
    if (!playerEid) { L("[take] не знаю идентификатор игрока"); return; }

    for (int i = 0; i < nn; i++) {
        uint8_t cat = nearby[i].cat;
        if (cat == CAT_QUEST || cat == CAT_SHOP || cat == CAT_DECOR) continue;  // не наше
        Action act = ACT_TAKE;
        if (nearby[i].dead == 1)      act = ACT_SEARCH;
        else if (cat == CAT_INSECT)   act = ACT_CATCH;
        L("[take] беру ближайшее: eid=%08X d=%.1f cat=0x%02X действие=%d",
          nearby[i].eid, nearby[i].d, cat, (int)act);
        send_action(act, nearby[i].eid, playerEid, 0x00);
        return;                       // за нажатие - один объект
    }
    L("[take] рядом нечего брать");
}

// Перехват пролога: забираем STEAL байт с начала функции, кладём их в
// переходник, а на их место пишем переход к нам. Байты пролога должны быть
// свободны от rip-относительной адресации - для этой функции проверено.
static bool hook_prologue(Hook &hk, unsigned char *target, void *handler,
                          int steal, const char *what) {
    if (!target) return false;
    if (steal < 12 || steal > 30) { L("[hook] %s: плохая длина пролога %d", what, steal); return false; }

    unsigned char *cave = alloc_near(target);
    if (!cave) { L("[hook] %s: нет памяти рядом", what); return false; }

    unsigned char st[160]; int n = 0;
    // сохраняем аргументы, зовём обработчик, восстанавливаем
    unsigned char pro[] = { 0x48,0x83,0xEC,0x48,
                            0x48,0x89,0x4C,0x24,0x20, 0x48,0x89,0x54,0x24,0x28,
                            0x4C,0x89,0x44,0x24,0x30, 0x4C,0x89,0x4C,0x24,0x38 };
    memcpy(st + n, pro, sizeof pro); n += sizeof pro;
    st[n++] = 0x48; st[n++] = 0xB8; *(void **)(st + n) = handler; n += 8;
    st[n++] = 0xFF; st[n++] = 0xD0;
    unsigned char epi[] = { 0x48,0x8B,0x4C,0x24,0x20, 0x48,0x8B,0x54,0x24,0x28,
                            0x4C,0x8B,0x44,0x24,0x30, 0x4C,0x8B,0x4C,0x24,0x38,
                            0x48,0x83,0xC4,0x48 };
    memcpy(st + n, epi, sizeof epi); n += sizeof epi;
    // перенесённый пролог - выполняется при том же rsp, что и в оригинале
    memcpy(st + n, target, steal); n += steal;
    // и возврат в тело функции
    st[n++] = 0x48; st[n++] = 0xB8; *(void **)(st + n) = target + steal; n += 8;
    st[n++] = 0xFF; st[n++] = 0xE0;
    memcpy(cave, st, n);

    memcpy(hk.orig, target, steal); hk.origLen = steal;
    unsigned char patch[30];
    patch[0] = 0x48; patch[1] = 0xB8; *(void **)(patch + 2) = cave;
    patch[10] = 0xFF; patch[11] = 0xE0;
    for (int i = 12; i < steal; i++) patch[i] = 0x90;     // добиваем NOP-ами
    if (!write_code(target, patch, steal)) { L("[hook] %s: запись не удалась", what); return false; }

    hk.site = target; hk.cave = cave; hk.active = true;
    L("[hook] %s: пролог перехвачен, +0x%llX -> %p (забрано %d байт)",
      what, (unsigned long long)(target - g_game.base), cave, steal);
    return true;
}

static bool hook_area() {
    return hook_prologue(g_areaHook, g_fn.areaFn, (void *)cdloot_on_area, 15, "обход сцены");
}

static void unhook_all() {
    if (g_areaHook.active) {
        write_code(g_areaHook.site, g_areaHook.orig, g_areaHook.origLen);
        g_areaHook.active = false;
        L("[hook] перехват снят, байты возвращены");
    }
    // Пещеру НЕ освобождаем намеренно: в ней может находиться поток игры прямо
    // сейчас. Утечка в 4 КБ на перезагрузку безопаснее падения.
}

// ------------------------------------------------------------- рабочий поток

static HANDLE g_thread;
static int g_scanKey = VK_F9;

static DWORD WINAPI worker(LPVOID) {
    int prev = 0;
    while (InterlockedCompareExchange(&g_running, 0, 0)) {
        int now = (GetAsyncKeyState(g_scanKey) & 0x8000) != 0;
        if (now && !prev) { InterlockedExchange(&g_scanRequested, 1); L("[key] F9 - обзор"); }
        static int prevTake = 0;
        int takeNow = (GetAsyncKeyState(VK_F8) & 0x8000) != 0;
        if (takeNow && !prevTake) {
            InterlockedExchange(&g_takeRequested, 1);
            InterlockedExchange(&g_scanRequested, 1);      // обзор нужен, чтобы выбрать цель
            L("[key] F8 - взять ближайшее");
        }
        prevTake = takeNow;
        prev = now;
        Sleep(20);
    }
    L("[core] рабочий поток остановлен");
    return 0;
}

// ------------------------------------------------------------------ экспорт -

// Наш ASI лежит в bin64, а туда же смотрит crashpad_handler.exe - служебный
// процесс игры. Загрузчик подхватывает нас и туда, и мы сканируем чужую
// память и держим файлы. Работаем только внутри самой игры.
static bool host_is_game() {
    char exe[MAX_PATH] = "";
    GetModuleFileNameA(NULL, exe, MAX_PATH);
    const char *name = strrchr(exe, (char)92);
    name = name ? name + 1 : exe;
    return _stricmp(name, "CrimsonDesert.exe") == 0;
}

CDEXPORT int CoreStart(const char *dir, int generation) {
    if (!host_is_game()) return 0;      // не игра - тихо уходим
    InitializeCriticalSection(&g_logCs);
    char path[MAX_PATH];
    // Пробуем общий лог загрузчика. Если он держит файл монопольно (старая
    // версия загрузчика), пишем в свой - лучше отдельный файл, чем немой мод.
    sprintf(path, "%sCDLoot.log", dir);
    g_log = CreateFileA(path, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE,
                        0, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0);
    if (g_log == INVALID_HANDLE_VALUE) {
        sprintf(path, "%sCDLoot_core.log", dir);
        g_log = CreateFileA(path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
                            0, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0);
    }
    g_logReady = true;
    L("=== CDLoot core запущен, поколение %d ===", generation);

    HMODULE h = GetModuleHandleA(NULL);          // главный модуль процесса
    if (!h) { L("модуль игры не найден"); return 0; }
    g_game.base = (unsigned char *)h;
    IMAGE_DOS_HEADER *dos = (IMAGE_DOS_HEADER *)h;
    IMAGE_NT_HEADERS64 *nt = (IMAGE_NT_HEADERS64 *)((unsigned char *)h + dos->e_lfanew);
    g_game.size = nt->OptionalHeader.SizeOfImage;
    L("игра: база=%p размер=0x%llX", g_game.base, (unsigned long long)g_game.size);

    if (!resolve_functions()) { L("[core] не запускаюсь"); return 0; }
    hook_area();

    InterlockedExchange(&g_running, 1);
    g_thread = CreateThread(0, 0, worker, 0, 0, 0);
    L("[core] готов. F9 - обзор сущностей.");
    return 1;
}

CDEXPORT void CoreStop() {
    L("[core] остановка...");
    InterlockedExchange(&g_running, 0);
    if (g_thread) { WaitForSingleObject(g_thread, 2000); CloseHandle(g_thread); g_thread = 0; }
    unhook_all();
    // даём игровым потокам выйти из нашей пещеры
    Sleep(120);
    L("[core] остановлен чисто");
    g_logReady = false;
    if (g_log != INVALID_HANDLE_VALUE) { CloseHandle(g_log); g_log = INVALID_HANDLE_VALUE; }
    DeleteCriticalSection(&g_logCs);
}

BOOL WINAPI DllMain(HINSTANCE h, DWORD reason, LPVOID) {
    if (reason == DLL_PROCESS_ATTACH) DisableThreadLibraryCalls(h);
    return TRUE;
}
